import /vendor/etc/init/hw/init.mtkgki.rc

#INTERNAL_START
on post-fs

    chmod 0660 /dev/spm
    chown system system /dev/spm


service spm_script /vendor/bin/spm_loader
    user system
    group system
    oneshot

#26M Clock calibration
service dcxosetcap /vendor/bin/dcxosetcap
    class main
    oneshot
    disabled

on property:vendor.service.nvram_init=Ready
    start dcxosetcap

#INTERNAL_END

service master_flag /vendor/bin/master_flag
    class late_start
    user system
    group system
    oneshot
    disabled

on boot 
    start master_flag

