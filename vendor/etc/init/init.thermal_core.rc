service thermal_core /vendor/bin/thermal_core
    class main
    socket thermal_socket stream 660 root system
    user root
    group system radio
    disabled

service thermal_screen_off /vendor/bin/thermal_intf apply thermal_screen_off.conf
    class main
    user root
    group system
    oneshot

service thermal_default /vendor/bin/thermal_intf apply thermal.conf
    class main
    user root
    group system
    oneshot

on charger
	setprop ro.vendor.mtk_thermal_kpoc 1

on property:ro.vendor.mtk_thermal_2_0=1
    start thermal_core

on property:sys.boot_completed=1
	write /sys/bus/platform/devices/soc:gpu-power-throttling/boot_notify 1
	write /sys/bus/platform/devices/soc:cpu-power-throttling/boot_notify 1

on property:persist.sys.tn.screenStatus=1
    start thermal_default

on property:persist.sys.tn.screenStatus=0
    exec /system/bin/sleep 0.2
    start thermal_screen_off
